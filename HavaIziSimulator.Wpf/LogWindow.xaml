<Window x:Class="HavaIziSimulator.Wpf.LogWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Gönderim Log'u"
        Width="1100"
        Height="700"
        MinWidth="700"
        MinHeight="450"
        WindowStartupLocation="CenterOwner">

    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Üst başlık -->
        <Grid Grid.Row="0" Margin="0,0,0,12">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>

            <StackPanel>
                <TextBlock Text="Gönderim Log'u"
                           FontSize="22"
                           FontWeight="Bold"/>

                <TextBlock Text="UDP üzerinden gönderilen mesajlar"
                           Margin="0,4,0,0"
                           Foreground="{DynamicResource MetinSoluk}"/>
            </StackPanel>

            <TextBlock Grid.Column="1"
                       Text="{Binding GonderilenMesajSayisi,
                                      StringFormat='Toplam mesaj: {0}'}"
                       VerticalAlignment="Center"
                       FontSize="14"
                       FontWeight="SemiBold"/>
        </Grid>

        <!-- Büyük log alanı -->
        <Border Grid.Row="1"
                Background="{DynamicResource PanelArkaPlan}"
                BorderBrush="{DynamicResource PanelKenarlik}"
                BorderThickness="1"
                CornerRadius="6"
                Padding="8">

            <ListBox x:Name="BuyukLogListesi"
                     ItemsSource="{Binding Loglar}"
                     FontFamily="Consolas"
                     FontSize="15"
                     ScrollViewer.HorizontalScrollBarVisibility="Auto"
                     ScrollViewer.VerticalScrollBarVisibility="Auto">

                <ListBox.ItemContainerStyle>
                    <Style TargetType="ListBoxItem"
                           BasedOn="{StaticResource {x:Type ListBoxItem}}">
                        <Setter Property="Padding" Value="8,5"/>
                        <Setter Property="HorizontalContentAlignment"
                                Value="Stretch"/>
                    </Style>
                </ListBox.ItemContainerStyle>
            </ListBox>
        </Border>

        <!-- Alt butonlar -->
        <Grid Grid.Row="2" Margin="0,12,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>

            <Button Grid.Column="1"
                    Content="Log'u Temizle"
                    Width="140"
                    Margin="0,0,10,0"
                    Style="{StaticResource TehlikeButonu}"
                    Command="{Binding LoglariTemizleKomutu}"/>

            <Button Grid.Column="2"
                    Content="Kapat"
                    Width="110"
                    IsCancel="True"
                    Style="{StaticResource IkincilButon}"
                    Click="Kapat_Click"/>
        </Grid>
    </Grid>
</Window>
